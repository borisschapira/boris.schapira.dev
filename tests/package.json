{
  "name": "boris-schapira-dev-tests",
  "version": "1.0.0",
  "description": "Post-build tests",
  "type": "module",
  "scripts": {
    "test:feeds": "node validate-feeds.js",
    "test:visual": "mocha --timeout 15000 visual-regression.js",
    "test:generatedContent": "bundle exec htmlproofer ../_site  --disable-external --ignore-empty-alt --enforce-https=false --allow-missing-href --check-external-hash=false",
    "test": "concurrently 'pn run test:feeds' 'pn run test:generatedContent'; pn run 'test:visual'",
    "validate:test:visual": "rimraf \"./captures/reference\"; mv \"./captures/test\" \"./captures/reference\";"
  },
  "author": "borisschapira",
  "license": "MIT",
  "dependencies": {
    "chai": "^6.2.2",
    "concurrently": "^9.2.1",
    "mocha": "^11.7.6",
    "open": "^11.0.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "puppeteer": "^25.0.4",
    "rimraf": "^6.1.3"
  }
}
