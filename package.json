{
  "name": "boris-schapira-dev-jekyll",
  "version": "1.0.0",
  "description": "My Jekyll setup.",
  "scripts": {
    "pretty:css": "prettier --write '_src/styles/scss/**/*.scss'",
    "pretty:md": "prettier --write '{,!(vendor)/**/*.md}'",
    "pretty:js": "prettier --write '_src/scripts/**/*.js'; prettier --write 'tests/*.{js,mjs}'",
    "pretty:tests": "prettier --write 'tests/*.{js,mjs}'",
    "pretty": "concurrently 'pn run pretty:css' 'pn run pretty:js' 'pn run pretty:tests' 'pn run pretty:md'",
    "build": "webpack",
    "postbuild": "node ./scripts/compute-hashes.js",
    "serve": "http-server ./_site -p 8080 -s -o",
    "test": "mocha --timeout 300000 tests/all.test.mjs",
    "validate:test:visual": "rimraf \"./tests/captures/reference\"; mv \"./tests/captures/test\" \"./tests/captures/reference\";"
  },
  "config": {
    "css_dir": "_src/styles/css/",
    "scss_dir": "_src/styles/scss/",
    "dist_dir": "assets/styles/"
  },
  "watch": {
    "_src/styles/scss/**/*.scss": [
      "pretty:css",
      "build"
    ],
    "_src/scripts/**/*.js": [
      "pretty:js",
      "build"
    ],
    "_posts/**/2019/*.md": [
      "prettier --write '{,!(vendor)/**/2019/*.md}'"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/borisschapira/jekyll-bs.git"
  },
  "author": "borisschapira",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/borisschapira/jekyll-bs/issues"
  },
  "homepage": "https://github.com/borisschapira/jekyll-bs#readme",
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/eslint-parser": "^8.0.1",
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/plugin-transform-runtime": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@fullhuman/postcss-purgecss": "^8.0.0",
    "autoprefixer": "^10.5.4",
    "babel-loader": "^10.1.1",
    "chai": "^6.2.2",
    "concat-cli": "^4.0.0",
    "concurrently": "^10.0.5",
    "cssnano": "^8.0.8",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-chai-expect": "^4.1.0",
    "eslint-plugin-import": "^2.32.0",
    "fast-xml-parser": "^5.11.1",
    "file-loader": "^6.2.0",
    "hasha": "^7.0.0",
    "http-server": "^14.1.1",
    "js-md5": "^0.9.2",
    "js-yaml": "^5.3.0",
    "mocha": "^11.8.0",
    "open": "^11.0.1",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.26",
    "postcss-cli": "^11.0.1",
    "postcss-loader": "^8.2.1",
    "prettier": "^3.9.6",
    "puppeteer": "^25.8.0",
    "rimraf": "^6.1.3",
    "sass": "^1.103.1",
    "sass-loader": "^17.0.0",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2"
  },
  "dependencies": {
    "abbr-touch": "^2.1.6",
    "easy-toggle-state": "^1.16.0",
    "include-media": "^2.0.0",
    "slugify": "^1.6.9",
    "touchtap-event": "^2.0.2"
  },
  "engines": {
    "pnpm": ">=11"
  }
}
